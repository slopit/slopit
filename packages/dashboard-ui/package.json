{
  "name": "@slopit/dashboard-ui",
  "version": "0.1.0",
  "description": "React dashboard UI for slopit behavioral analytics",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Aaron Steven White",
    "email": "aaron.white@rochester.edu",
    "url": "https://aaronstevenwhite.io"
  },
  "homepage": "https://slopit.github.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slopit/slopit.git",
    "directory": "packages/dashboard-ui"
  },
  "bugs": {
    "url": "https://github.com/slopit/slopit/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "dashboard",
    "react",
    "analytics",
    "visualization",
    "ai-detection",
    "behavioral-research"
  ],
  "main": "./dist/slopit-dashboard.umd.cjs",
  "module": "./dist/slopit-dashboard.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/slopit-dashboard.js",
      "require": "./dist/slopit-dashboard.umd.cjs"
    },
    "./web-component": {
      "types": "./dist/web-component.d.ts",
      "import": "./dist/slopit-dashboard-wc.js"
    },
    "./style.css": "./dist/slopit-dashboard.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:wc": "vite build --config vite.wc.config.ts",
    "build:all": "pnpm build && pnpm build:wc",
    "deploy": "pnpm build:all && cp dist/slopit-dashboard-wc.css dist/slopit-dashboard-wc.js ../../python/src/slopit/dashboard/static/",
    "preview": "vite preview",
    "lint": "biome check src/",
    "format": "biome format --write src/",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@slopit/core": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.4.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  }
}
