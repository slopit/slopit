{
  "name": "@slopit/adapter-psychojs",
  "version": "0.1.0",
  "description": "PsychoJS adapter for slopit behavioral capture",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Aaron Steven White",
    "email": "aaron.white@rochester.edu",
    "url": "https://aaronstevenwhite.io"
  },
  "homepage": "https://slopit.github.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slopit/slopit.git",
    "directory": "packages/adapter-psychojs"
  },
  "bugs": {
    "url": "https://github.com/slopit/slopit/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "psychojs",
    "pavlovia",
    "behavioral-research",
    "experiment",
    "psychology",
    "ai-detection",
    "crowdsourcing"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@slopit/adapter-shared": "workspace:*",
    "@slopit/behavioral": "workspace:*",
    "@slopit/core": "workspace:*"
  },
  "devDependencies": {
    "jsdom": "^28.1.0",
    "tsup": "^8.3.5",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
